# Shell syntax: quote values that contain spaces or #. Variables already set in the shell win.
# openssl rand -hex 32 for each. The signing key must be hex; the dev server accepts any.
AETHER_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local dev server instead of Inngest Cloud. scripts/up.sh starts one if nothing answers here.
INNGEST_DEV=http://127.0.0.1:8288

# Optional, read by scripts/up.sh
# ALLOWLIST=allowlist.json
# DB=aether.db
# LISTEN=:8080
# ROOT=./daemons
# INNGEST_CLI_VERSION=1.44.0

# Fallback model for daemons with none set on their row. Per daemon: aether model <name> <spec>.
# Specs: openai:<model> (default openai:gpt-5.4-mini), anthropic:<model>, or scripted for an offline stub
# AETHER_MODEL=openai:gpt-5.4-mini
# AETHER_MAX_TURNS=50
# Provider keys. connect passes them through to daemon processes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
